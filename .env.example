# SUPERNOVA Configuration
# Copy this file to .env and adjust as needed.

# Model provider: "mock" (default, no external dependencies) or "ollama" (post-MVP)
SUPERNOVA_PROVIDER=mock

# Default model name (used when no per-agent override is set)
SUPERNOVA_DEFAULT_MODEL=mock-structured

# Mock provider latency simulation (milliseconds)
SUPERNOVA_MOCK_LATENCY_MIN_MS=800
SUPERNOVA_MOCK_LATENCY_MAX_MS=2000

# Ollama configuration (post-MVP)
# SUPERNOVA_OLLAMA_URL=http://localhost:11434

# If the configured provider fails, fall back to mock
SUPERNOVA_FALLBACK_TO_MOCK=true

# Agent execution
SUPERNOVA_MAX_RETRIES=2
SUPERNOVA_REQUEST_TIMEOUT_S=120

# Database
SUPERNOVA_DATABASE_URL=sqlite+aiosqlite:///./supernova.db

# Frontend URL (for CORS)
SUPERNOVA_FRONTEND_URL=http://localhost:3000
